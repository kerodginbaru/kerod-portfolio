APP_NAME="Kerod Ginbaru Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kerod_portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Comma-separated list of domains allowed to authenticate via Sanctum's
# stateful (cookie-based) guard. Include the frontend's host + port.
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Frontend origin, used for CORS and for links generated in emails.
FRONTEND_URL=http://localhost:3000

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kerodginbaru.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact form notifications are sent.
CONTACT_NOTIFICATION_EMAIL=kerodhope@gmail.com
